# ==============================================================================
# elyrn. Environment Configuration Example
# Copy to .env and adjust values or run 'make setup' to generate automatically.
# ==============================================================================

# Cryptographic Keys (Auto-generated by 'make setup')
JWT_SECRET=
JWT_SECRET_MIN_LEN=32
# JWT issuer/audience and DB_NAME are stored names, kept as "noaddx" across the rename to elyrn.
JWT_ISSUER=noaddx-backend
JWT_AUDIENCE=noaddx-web
# Session lifetime in minutes, 1-525600 (365 days); default 43200 (30 days). Sliding: a session
# used in the second half of its lifetime is renewed, so it ends only after logout, account
# deletion, or about 15-30 days without use.
JWT_EXPIRATION_MINUTES=43200

MASTER_KEY_ACTIVE_ID=
MASTER_KEY_ACTIVE=
MASTER_KEY_OLD=
ACCOUNT_LOOKUP_PEPPER=

# Database Configuration
# DB_HOST: host address when running tests on host machine (e.g. localhost)
# DOCKER_DB_HOST: container service name inside docker compose network (postgres)
DB_HOST=localhost
DOCKER_DB_HOST=postgres
DB_PORT=5432
# Loopback port of PostgreSQL in development only (docker-compose.dev.yaml)
DB_HOST_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=noaddx
# Host-side tools only (make test-db against a local PostgreSQL). The Compose backend always
# uses verify-full with the CA from make certs: the bundled database refuses TCP without TLS.
DB_SSL_MODE=disable

# Application & Network Settings
# development: for http://localhost (unprefixed session cookie without Secure; works in every
#   browser). production: __Host-Session cookie with Secure and every production check; make
#   onion requires it. See docs/operations/configuration-and-tuning.md#production-mode
APP_ENV=development
LOG_LEVEL=info
BACKEND_PORT=8080
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
# Who may name the client to the backend. Empty = nginx at PROXY_IP (below), which is right
# under Compose: a proxy in front of nginx goes in EDGE_TRUSTED_PROXIES, not here. Set this only
# for a backend run outside Compose behind your own proxy.
TRUSTED_PROXIES=
# Your own TLS-terminating reverse proxy in front of nginx (comma-separated IPs/CIDRs, prefix
# 1 or more; empty = none). Only a request whose TCP peer is listed may name the client
# (X-Forwarded-For, so each user gets their own rate limit) and the protocol (X-Forwarded-Proto).
# A proxy on the same host reaches nginx from the edge network's gateway (the first address of
# EDGE_SUBNET, e.g. 172.29.72.1): list exactly that address, never a whole subnet. A malformed
# value stops nginx at start.
EDGE_TRUSTED_PROXIES=

# HSTS (backend, API answers; production over HTTPS only, which behind your own proxy needs
# EDGE_TRUSTED_PROXIES). 0 = off. Up to 63072000 (two years). Booleans: true or false.
HSTS_MAX_AGE=0
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false

# Docker networks (docs/operations/hardening.md): app (nginx, backend; internal), edge (nginx,
# tor; the published port), data (backend, postgres; internal). nginx gets a fixed address on
# app so the backend can trust exactly it.
COMPOSE_SUBNET=172.29.73.0/24
PROXY_IP=172.29.73.10
# backend: fixed so nginx (which resolves it once, at start) always finds it after a recreate
BACKEND_IP=172.29.73.12
EDGE_SUBNET=172.29.72.0/24
# tor container (make onion), on edge: the only peer allowed on nginx's onion listener
TOR_IP=172.29.72.11
DATA_SUBNET=172.29.74.0/24
HTTP_PORT=80
# Backend container memory: at least ARGON2_MAX_CONCURRENT x ARGON2_MEMORY_KIB + 128 MiB
BACKEND_MEM_LIMIT=512m
BACKEND_GOMEMLIMIT=448MiB

# HTTP Payload and JSON Limits
MAX_REQUEST_BODY_BYTES=1048576
MAX_JSON_DEPTH=2

# Messaging, Invites and Retention
INVITE_TTL_SEC=86400
MAX_ACTIVE_INVITES=5
MAX_CONVERSATIONS_PER_USER=256
MAX_MESSAGE_BYTES=8192
MESSAGE_PAGE_LIMIT=200
MESSAGE_TTL_DAYS=7

# Rooms (code-based group conversations): largest room (2-32) and longest lifetime in hours (1-720)
ROOM_MAX_MEMBERS=16
ROOM_MAX_TTL_HOURS=168

# Proof of Work (Hashcash)
POW_DIFFICULTY=20
POW_CHALLENGE_TTL_SEC=300

# Argon2id Hashing Parameters
ARGON2_MEMORY_KIB=65536
ARGON2_TIME=3
ARGON2_PARALLELISM=2
ARGON2_SALT_LENGTH=16
ARGON2_HASH_LENGTH=32
# At most this many Argon2id computations at once (each takes ARGON2_MEMORY_KIB); 1-64
ARGON2_MAX_CONCURRENT=4

# Pending Registration Store
PENDING_TOKEN_TTL_SEC=300
PENDING_CLEANUP_INTERVAL_SEC=60
PENDING_ID_BYTES=16
INTERNAL_ID_LENGTH=24

# Rate Limiting
RATE_LIMIT_MAX_TOKENS=20
RATE_LIMIT_REFILL_INTERVAL_SEC=3
RATE_LIMIT_CLEANUP_INTERVAL_SEC=300
RATE_LIMIT_MAX_BUCKETS=10000

# Server HTTP Timeouts
SERVER_READ_HEADER_TIMEOUT_SEC=5
SERVER_READ_TIMEOUT_SEC=15
SERVER_WRITE_TIMEOUT_SEC=15
SERVER_IDLE_TIMEOUT_SEC=60
SERVER_MAX_HEADER_BYTES=8192
