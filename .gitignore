# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work

# Go binaries built at the module root (anchored: never match source dirs like cmd/server)
/backend/server
/backend/main
# make agent output
/bin/

# Dependencies
vendor/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
*.log

# Environment variables: .env and every variant of it (.env.local, .env.production, a copy
# saved as .env.bak...), anywhere in the tree; only the template is tracked
.env
.env.*
!/.env.example

# Test results
test-results/
*.coverprofile
coverage.out
coverage.txt
/frontend.sha256
# make backup-accounts output: account data, never committed
/backups/

# make certs output: the database CA key and the PostgreSQL server key (never committed)
/certs/
# Private keys and certificates anywhere in the tree (a key copied out of certs/, a local TLS
# test key): never committed
*.pem
*.key
